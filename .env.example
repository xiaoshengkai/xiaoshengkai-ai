# =============================================================================
# ai-engineer-journey 共享环境变量
# =============================================================================
# 复制此文件为 `.env` 并填入真实值:
#   cp .env.example .env
#
# 此文件被以下项目共用:
#   - packages/ai-chat (next.config.ts dotenv 加载)
#   - packages/mcp (lib/env.js dotenv 加载)
# =============================================================================

# ---------- LLM Providers ----------------------------------------------------

# MCP 工具文字生成: deepseek | minimax
LLM_PROVIDER=deepseek

# DeepSeek V4 Pro(对话生成)
DEEPSEEK_API_KEY=your_deepseek_api_key_here
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_PRO_MODEL=deepseek-v4-pro
DEEPSEEK_FLASH_MODEL=deepseek-v4-flash

# 智谱 AI(embedding-3, 2048 维向量)
GLM_API_KEY=your_glm_api_key_here
GLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4
GLM_EMBEDDING_MODEL=embedding-3

# 通义千问 Qwen3.8-Max(多模态, chat + MCP/工作流)
QWEN_API_KEY=your_qwen_api_key_here
QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
QWEN_CHAT_MODEL=qwen3.8-max

# ---------- Media Generation -------------------------------------------------

# MiniMax(图片生成)
MINIMAX_API_KEY=your_minimax_api_key_here
MINIMAX_BASE_URL=https://api.minimaxi.com/v1
MINIMAX_IMAGE_MODEL=image-01
MINIMAX_CHAT_MODEL=MiniMax-M3

# ---------- PushPlus (微信推送) -----------------------------------------------

# 定时任务推送，访问 https://www.pushplus.plus/ 获取
PUSHPLUS_TOKEN=your_pushplus_token_here
PUSHPLUS_TOPIC=
PUSHPLUS_TO=

# 火山引擎 Volcengine (Doubao Seedream 图片生成)
VOLCENGINE_API_KEY=your_volcengine_api_key_here
VOLCENGINE_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
VOLCENGINE_IMAGE_MODEL=doubao-seedream-5-0-lite-260128
# 火山 GetAFPUsage（模型概况余额查询，签名 V4 用 AK/SK）
VOLCENGINE_ACCESS_KEY=your_volcengine_access_key_here
VOLCENGINE_SECRET_KEY=your_volcengine_secret_key_here

# ---------- Firecrawl (网页正文抓取) -----------------------------------------

# 联网搜索 searchWeb 的正文抓取，访问 https://firecrawl.dev 获取
FIRECRAWL_API_KEY=your_firecrawl_api_key_here