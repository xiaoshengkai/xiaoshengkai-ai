!packages/ai-chat/src/app/(main)/logs/
site/
docs/
packages/.planning/packages/workflows/templates/video-generation-v2/lib/sfx/*.mp3

# auto-generated dashboards
packages/tasks/**/dashboard.html
# search service (SearXNG 源码 clone + venv，首次启动自动生成)
packages/services/search/searxng/searxng-src/
packages/services/search/searxng/venv/

nohup.out

.superpowers/
data-backup/
.env.bak-*
