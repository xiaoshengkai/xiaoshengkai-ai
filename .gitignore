# dependencies
node_modules/
packages/*/node_modules/

# env files
.env
!.env.example

# misc
.DS_Store
*.pem
AGENTS.md

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
logs/data/conversations/

# uploaded files
data/static/*
!data/static/.gitkeep
data/chroma/

/ai-chat
packages/ai-chat/.next
packages/ai-chat/.next-prod
data
logs/
