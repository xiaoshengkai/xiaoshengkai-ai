{
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "postinstall": "node scripts/fix-transformers-mjs.mjs",
    "dev": "bash scripts/dev.sh",
    "build": "npm run build -w packages/ai-chat",
    "lint": "npm run lint -w packages/ai-chat",
    "prod": "bash scripts/prod.sh",
    "stop": "bash scripts/stop.sh",
    "log": "bash scripts/log.sh",
    "tasks:start": "node packages/tasks/scheduler.js",
    "tasks:stop": "kill $(lsof -t -i:4568) 2>/dev/null || true",
    "tasks:run": "node -e \"import('./packages/tasks/$TASK/index.js').then(m=>m.run())\"",
    "test:video-v2": "node packages/workflows/templates/tech-video/test.js"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^3.0.110",
    "@chroma-core/default-embed": "^0.1.9",
    "axios": "^1.18.1",
    "dotenv": "^17.4.2",
    "node-cron": "^3.0.3"
  },
  "devDependencies": {
    "http-proxy": "^1.18.1"
  }
}
