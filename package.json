{
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "postinstall": "node scripts/fix-transformers-mjs.mjs",
    "dev": "bash scripts/dev.sh",
    "build": "npm run build -w packages/ai-chat",
    "lint": "npm run lint -w packages/ai-chat",
    "prod": "bash scripts/prod.sh",
    "stop": "bash scripts/stop.sh",
    "log": "bash scripts/log.sh",
    "tasks:start": "node packages/tasks/scheduler.js",
    "tasks:stop": "kill $(lsof -t -i:4567) 2>/dev/null || true",
    "tasks:run": "node packages/tasks/run-task.js",
    "test": "npm run test:shared && npm run test:mm && npm run test:search",
    "test:shared": "node --test packages/shared/test/*.test.js",
    "test:mm": "npm exec -w packages/ai-chat -- tsx --test ../shared/test/ai-chat-multimodal.test.ts ../shared/test/conversations-store.test.ts ../shared/test/services-manager.test.ts ../shared/test/modes.test.ts",
    "test:search": "node --test packages/services/search/test/normalize.test.js",
    "test:search:live": "node --test packages/services/search/test/live.test.js",
    "typecheck": "npm exec -w packages/ai-chat tsc -- --noEmit --incremental false",
    "test:video-v2": "node packages/workflows/templates/tech-video/test.js"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^3.0.110",
    "@chroma-core/default-embed": "^0.1.9",
    "axios": "^1.18.1",
    "dotenv": "^17.4.2",
    "node-cron": "^3.0.3"
  },
  "devDependencies": {
    "http-proxy": "^1.18.1"
  }
}
