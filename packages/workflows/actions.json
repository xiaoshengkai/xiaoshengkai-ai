[
  { "type": "cli", "method": "GET",    "path": "/templates",           "command": "templates" },
  { "type": "cli", "method": "POST",   "path": "/execute",             "command": "start",  "args": { "template": "body.template", "params": "body.params" }, "required": ["template"] },
  { "type": "cli", "method": "GET",    "path": "/executions",          "command": "list" },
  { "type": "cli", "method": "GET",    "path": "/execution/:id",       "command": "get",    "args": { "executionId": "param.id" }, "notFound": { "field": "error", "value": "not found" } },
  { "type": "cli", "method": "DELETE", "path": "/execution/:id",       "command": "delete", "args": { "executionId": "param.id" } },
  { "type": "stream", "method": "GET", "path": "/execution/:id/file/*" },
  { "type": "cli", "method": "POST",   "path": "/execution/:id/next",  "command": "next",   "args": { "executionId": "param.id" }, "timeout": 900000 },
  { "type": "cli", "method": "POST",   "path": "/execution/:id/auto",  "command": "auto",   "args": { "executionId": "param.id" }, "detached": true },
  { "type": "cli", "method": "POST",   "path": "/execution/:id/retry", "command": "retry",  "args": { "executionId": "param.id", "stepId": "body.stepId", "force": "body.force" }, "required": ["stepId"], "timeout": 1200000 },
  { "type": "cli", "method": "POST",   "path": "/execution/:id/skip",  "command": "skip",   "args": { "executionId": "param.id", "stepId": "body.stepId" }, "required": ["stepId"], "timeout": 10000 },
  { "type": "cli", "method": "POST",   "path": "/execution/:id/tweak", "command": "tweak-auto", "args": { "executionId": "param.id", "feedback": "body.feedback", "images": "body.imagePaths", "pages": "body.pages", "mode": "body.mode" }, "detached": true, "respond": { "ok": true, "status": "running" } },
  { "type": "custom", "method": "GET",    "path": "/assets/characters",          "handler": "list-characters" },
  { "type": "custom", "method": "POST",   "path": "/assets/characters/generate", "handler": "generate-character" },
  { "type": "custom", "method": "POST",   "path": "/assets/characters",          "handler": "save-character" },
  { "type": "custom", "method": "DELETE", "path": "/assets/characters/:id",      "handler": "delete-character" },
  { "type": "stream", "method": "GET",    "path": "/assets/characters/*",        "dir": "data/workflows/assets/characters" },
  { "type": "custom", "method": "GET",    "path": "/assets/styles",              "handler": "list-styles" },
  { "type": "custom", "method": "POST",   "path": "/assets/styles",              "handler": "create-style" },
  { "type": "custom", "method": "DELETE", "path": "/assets/styles/:id",          "handler": "delete-style" }
]
