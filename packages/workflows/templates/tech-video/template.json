{
  "name": "tech-video",
  "label": "科技风 短视频生成",
  "description": "script.json 驱动 + 逐场景渲染 + TTS + BGM + SFX + 硬字幕 + SRT",
  "available": false,
  "params": [
    { "name": "title", "label": "视频标题", "type": "text", "required": true },
    { "name": "content", "label": "视频内容描述", "type": "textarea", "required": false, "placeholder": "详细描述视频内容（可选，不填则用标题生成）" },
    { "name": "voice_id", "label": "TTS音色", "type": "text", "default": "male-qn-qingse" },
    { "name": "bgm_volume", "label": "BGM音量", "type": "number", "default": 0.2 },
    { "name": "bgm_file", "label": "BGM 音频（可选）", "type": "text", "required": false, "placeholder": "上传 mp3/wav 文件" }
  ],
  "steps": [
    {
      "id": "script",
      "name": "AI 生成 script.json",
      "type": "tool",
      "previewType": "json",
      "previewField": "script",
      "module": "./lib/prompt-builder.js",
      "function": "generateScript",
      "args": ["{title}", "{content}"]
    },
    {
      "id": "validate",
      "name": "校验 script.json",
      "type": "tool",
      "previewType": "text",
      "previewField": "output",
      "module": "./lib/prompt-builder.js",
      "function": "validateScriptStep",
      "args": ["{script.script}"]
    },
    {
      "id": "tts-scenes",
      "name": "TTS 逐场景合成",
      "type": "tool",
      "previewType": "text",
      "previewField": "output",
      "module": "./lib/tts.js",
      "function": "generateTTSForScenes",
      "args": ["{script.script}", "{voice_id}", "{executionDir}"]
    },
    {
      "id": "bgm",
      "name": "BGM 生成",
      "type": "tool",
      "previewType": "audio",
      "previewField": "bgm.mp3",
      "module": "./lib/bgm.js",
      "function": "generateBGM",
      "args": ["{script.script}", "{executionDir}", "{bgm_file}"]
    },
    {
      "id": "sfx-pick",
      "name": "SFX 音效匹配",
      "type": "tool",
      "previewType": "text",
      "previewField": "output",
      "module": "./lib/sfx.js",
      "function": "pickSfxForAllScenes",
      "args": ["{script.script}", "{executionDir}"]
    },
    {
      "id": "render",
      "name": "逐场景渲染 MP4",
      "type": "tool",
      "previewType": "text",
      "previewField": "output",
      "module": "./lib/render.js",
      "function": "renderScenes",
      "args": ["{script.script}", "{executionDir}"]
    },
    {
      "id": "concat",
      "name": "合成最终视频",
      "type": "tool",
      "previewType": "video",
      "previewField": "video.mp4",
      "module": "./lib/concat.js",
      "function": "concatFinalVideo",
      "args": ["{script.script}", "{executionDir}"]
    }
  ]
}