{
  "name": "video-generation-v2",
  "label": "短视频生成 v2",
  "description": "script.json 驱动 + 逐场景渲染 + TTS + BGM + SFX + 硬字幕 + SRT",
  "params": [
    { "name": "title", "label": "视频标题", "type": "text", "required": true },
    { "name": "style", "label": "视觉风格", "type": "select", "options": ["Neo-Brutalist", "奶油风", "极简黑白"], "default": "Neo-Brutalist" },
    { "name": "content", "label": "视频内容描述", "type": "textarea", "required": false, "placeholder": "详细描述视频内容（可选，不填则用标题生成）" },
    { "name": "brand", "label": "品牌名（可选）", "type": "text", "required": false, "placeholder": "如：小盛开AI" },
    { "name": "voice_id", "label": "TTS音色", "type": "text", "default": "male-qn-qingse" },
    { "name": "bgm_volume", "label": "BGM音量", "type": "number", "default": 0.2 }
  ],
  "steps": [
    {
      "id": "script",
      "name": "AI 生成 script.json",
      "type": "tool",
      "previewType": "json",
      "previewField": "script",
      "module": "./lib/prompt-builder.js",
      "function": "generateScript",
      "args": ["{title}", "{style}", "{content}", "{brand}"]
    },
    {
      "id": "validate",
      "name": "校验 script.json",
      "type": "tool",
      "previewType": "text",
      "previewField": "output",
      "module": "./lib/prompt-builder.js",
      "function": "validateScriptStep",
      "args": ["{script.script}"]
    },
    {
      "id": "tts-scenes",
      "name": "TTS 逐场景合成",
      "type": "tool",
      "previewType": "text",
      "previewField": "output",
      "module": "./lib/tts.js",
      "function": "generateTTSForScenes",
      "args": ["{script.script}", "{voice_id}", "{executionDir}"]
    },
    {
      "id": "bgm",
      "name": "BGM 生成",
      "type": "tool",
      "previewType": "audio",
      "previewField": "bgm.mp3",
      "module": "./lib/bgm.js",
      "function": "generateBGM",
      "args": ["{script.script}", "{executionDir}"]
    },
    {
      "id": "sfx-pick",
      "name": "SFX 音效匹配",
      "type": "tool",
      "previewType": "text",
      "previewField": "output",
      "module": "./lib/sfx.js",
      "function": "pickSfxForAllScenes",
      "args": ["{script.script}", "{executionDir}"]
    },
    {
      "id": "preview",
      "name": "构建 HTML 预览",
      "type": "tool",
      "previewType": "iframe",
      "previewField": "preview/full.html",
      "module": "./lib/preview.js",
      "function": "buildPreview",
      "args": ["{script.script}", "{executionDir}"]
    },
    {
      "id": "render",
      "name": "逐场景渲染 MP4",
      "type": "tool",
      "previewType": "text",
      "previewField": "output",
      "module": "./lib/render.js",
      "function": "renderScenes",
      "args": ["{script.script}", "{executionDir}", "{brand}"]
    },
    {
      "id": "concat",
      "name": "合成最终视频",
      "type": "tool",
      "previewType": "video",
      "previewField": "video.mp4",
      "module": "./lib/concat.js",
      "function": "concatFinalVideo",
      "args": ["{script.script}", "{executionDir}"]
    }
  ]
}