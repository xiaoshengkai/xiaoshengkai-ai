{
  "name": "video-generation",
  "label": "短视频生成",
  "description": "script.json 驱动 + TTS + BGM + 渲染",
  "available": false,
  "params": [
    { "name": "title", "label": "视频标题", "type": "text", "required": true },
    { "name": "contentRequirement", "label": "内容要求（可选）", "type": "textarea", "required": false, "placeholder": "如：场景要反转、用emoji做SVG、每场景英文标题" },
    { "name": "content", "label": "视频内容描述", "type": "textarea", "required": false, "placeholder": "详细描述视频内容（可选，不填则用标题生成）" },
    { "name": "style", "label": "视觉风格（可选）", "type": "select", "options": ["自动（AI 决定）", "Neo-Brutalist", "奶油风", "极简黑白"], "default": "自动（AI 决定）", "required": false },
    { "name": "enable_tts", "label": "TTS 语音合成", "type": "select", "options": ["yes", "no"], "default": "yes" },
    { "name": "voice_id", "label": "TTS音色", "type": "text", "default": "male-qn-qingse" },
    { "name": "enable_bgm", "label": "BGM 背景音乐", "type": "select", "options": ["yes", "no"], "default": "yes", "required": false },
    { "name": "bgm_volume", "label": "BGM音量", "type": "number", "default": 0.3 },
    { "name": "bgm_file", "label": "BGM 音频（可选）", "type": "text", "required": false, "placeholder": "上传 mp3/wav 文件" }
  ],
  "steps": [
    {
      "id": "script",
      "name": "AI 生成 script.json",
      "type": "tool",
      "previewType": "json",
      "previewField": "script",
      "module": "./lib/prompt-builder.js",
      "function": "generateScript",
      "args": ["{title}", "{content}", "{style}"]
    },
    {
      "id": "tts",
      "name": "TTS 语音合成",
      "type": "tool",
      "previewType": "audio",
      "previewField": "narration.mp3",
      "module": "./lib/tts.js",
      "function": "generateTTS",
      "args": ["{script.allNarration}", "{voice_id}", "{executionDir}", "{enable_tts}"],
      "skipWhen": "enable_tts_no"
    },
    {
      "id": "bgm",
      "name": "BGM 生成",
      "type": "tool",
      "previewType": "audio",
      "previewField": "bgm.mp3",
      "module": "./lib/bgm.js",
      "function": "generateBGM",
      "args": ["{script.bgm_prompt}", "{executionDir}", "{bgm_file}"],
      "skipWhen": ["enable_bgm_no", "has_bgm_file"]
    },
    {
      "id": "render",
      "name": "渲染 MP4",
      "type": "tool",
      "previewType": "video",
      "previewField": "videoFile",
      "module": "./lib/render.js",
      "function": "renderMP4",
      "args": ["{executionDir}", "{script.allHtml}", "{script.css}", "{script.jsAnimation}", "{script.scenesJson}"]
    }
  ]
}